# ═══════════════════════════════════════════════════════════════════════════════
# SocialMedia Agent — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════════════════
# Copie este arquivo: cp .env.example .env
# Preencha APENAS as chaves dos provedores que você vai usar.
# O sistema usa cascata automática: Claude → Gemini → Groq → DeepSeek → GPT-4o-mini
# ═══════════════════════════════════════════════════════════════════════════════

# ── PROVEDORES DE TEXTO (CASCATA AUTOMÁTICA) ───────────────────────────────────
# Adicione as chaves dos provedores que desejar usar.
# Pelo menos uma chave é obrigatória para geração de copy.

OPENROUTER_API_KEY=           # https://openrouter.ai  → Acesso multi-modelo (Claude, GPT, etc.)
GOOGLE_API_KEY=               # https://aistudio.google.com → Gemini Flash/Pro
GROQ_API_KEY=                 # https://console.groq.com  → Llama 3 (ultrarrápido)
DEEPSEEK_API_KEY=             # https://platform.deepseek.com → DeepSeek (econômico)
OPENAI_API_KEY=               # https://platform.openai.com → GPT-4o / DALL-E 3

# ── MODELO DE TEXTO PRIMÁRIO ───────────────────────────────────────────────────
# Define qual modelo LLM será usado por padrão para geração de copy.
# Exemplos:
#   anthropic/claude-sonnet-4-5   (melhor qualidade emocional)
#   openai/gpt-4o                 (versátil)
#   google/gemini-2.0-flash-001   (econômico e rápido)
MODEL_TEXT=anthropic/claude-sonnet-4-5

# ── MODELO DE IMAGEM ───────────────────────────────────────────────────────────
# 'flux'     → Pollinations AI (gratuito, sem chave)
# 'dall-e-3' → OpenAI DALL-E 3 (requer OPENAI_API_KEY)
MODEL_IMAGE=flux

# ── BASE URL DO OPENROUTER ─────────────────────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── MODELO DE VISÃO (análise de imagens) ──────────────────────────────────────
MODEL_VISION=google/gemini-2.0-flash-001

# ── CLOUDINARY (Upload → URL Pública para Meta API) ───────────────────────────
# Crie sua conta em https://cloudinary.com e copie os valores do Dashboard.
CLOUDINARY_CLOUD_NAME=        # ex: meu-cloud
CLOUDINARY_API_KEY=           # ex: 123456789012345
CLOUDINARY_API_SECRET=        # ex: AbCdEfGhIjKlMnOpQrStUvWxYz

# ── MULTI-TENANT (Opcional) ────────────────────────────────────────────────────
# Quando definido, organiza uploads Cloudinary como:
#   SocialMedia_Agent/{CLOUDINARY_CLIENTE}/{tipo}
# Quando vazio, usa:
#   SocialMedia_Agent/{tipo}
# CLOUDINARY_CLIENTE=nome_do_cliente

# ── MODO DE OPERAÇÃO DO LLM ROUTER ────────────────────────────────────────────
# cheap    → Modelos mais econômicos (Groq / DeepSeek)
# balanced → Padrão recomendado (Claude Sonnet / GPT-4o-mini)
# premium  → Máxima qualidade (Claude Opus / GPT-4o)
LLM_MODE=balanced
